@page "/aspclassic-vbscript/view"

@using ASPClassic.Application.DTOs.Core
@using ASPClassic.Pages.Inc

@namespace ASPClassic.Pages.View

@* Port of view.asp — resolves NavID to either a DataView page or an external NavUri *@

<PageTitle>@_pageTitle</PageTitle>

<IncMetaComponent />

<IncHeaderComponent />

<div style="display:flex; flex-direction:column; height:100%; flex:1; overflow:hidden;">

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_navigationResult is not null)
    {
        @if (_hasDataView)
        {
            @* Legacy rendered an iframe pointing to dataview.asp?ViewID=N — 
               in Blazor we navigate to the dataview page instead *@
            <div style="flex:1; display:flex; flex-direction:column; overflow:hidden;">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    <MudText Typo="Typo.body2">
                        Navigating to DataView: @_navigationResult.NavLabel
                    </MudText>
                </MudAlert>
                <MudText Typo="Typo.h6" Class="mb-2">@_navigationResult.NavLabel</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.OpenInNew"
                           OnClick="NavigateToDataView">
                    Open DataView
                </MudButton>
            </div>
        }
        else if (!string.IsNullOrEmpty(_resolvedUri))
        {
            @* Legacy rendered an iframe with NavUri — show external link info *@
            <div style="flex:1; display:flex; flex-direction:column; overflow:hidden;">
                <MudText Typo="Typo.h6" Class="mb-2">@_navigationResult.NavLabel</MudText>
                @if (_navigationResult.OpenUriInIFRAME)
                {
                    <iframe src="@_resolvedUri"
                            style="width:100%; flex:1; min-height:400px; border:none; overflow:auto;"
                            title="@_navigationResult.NavLabel">
                    </iframe>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        <MudText Typo="Typo.body2">External link: @_resolvedUri</MudText>
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               Href="@_resolvedUri"
                               Target="_blank">
                        Open Link
                    </MudButton>
                }
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                Navigation item found but has no associated view or URI.
            </MudAlert>
        }
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
    }
    else
    {
        @* No NavID provided — legacy would show 404.asp in iframe *@
        <MudAlert Severity="Severity.Warning" Dense="true">
            No navigation item specified. Please select an item from the sidebar.
        </MudAlert>
    }

</div>

<IncFooterComponent />

<IncFooterJscriptsComponent />

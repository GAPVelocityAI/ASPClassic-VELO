@using ASPClassic.Infrastructure.Navigation
@using MudBlazor

@* Port of inc_nav_side.asp — Main Sidebar Navigation Component *@

<div class="sidebar-container" style="display:flex; flex-direction:column; height:100%; background-color:var(--mud-palette-dark); color:var(--mud-palette-white);">
    @* Brand Logo *@
    <div style="padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.1); flex-shrink:0;">
        <MudLink Href="/aspclassic-vbscript/default"
                 Underline="Underline.None"
                 Style="display:flex; align-items:center; gap:10px; color:white; text-decoration:none;">
            <MudAvatar Size="Size.Small" Style="background-color:rgba(255,255,255,0.15);">
                <MudIcon Icon="@Icons.Material.Filled.Water" Size="Size.Small" />
            </MudAvatar>
            <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:300;">
                Crude<b>ASP</b>
            </MudText>
        </MudLink>
    </div>

    @* Sidebar Menu *@
    <div style="flex:1; overflow-y:auto; padding:8px 0;">
        <MudText Typo="Typo.caption" Style="padding:8px 16px; color:rgba(255,255,255,0.5); text-transform:uppercase; font-weight:700; letter-spacing:0.05em;">
            Menu
        </MudText>

        @if (_isLoading)
        {
            <div style="padding:8px 16px; display:flex; align-items:center; gap:8px; color:rgba(255,255,255,0.6);">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.6);">Loading...</MudText>
            </div>
        }
        else if (_navigationNodes is not null && _navigationNodes.Count > 0)
        {
            @foreach (var node in _navigationNodes)
            {
                @RenderNavNode(node, 0)
            }
        }
        else
        {
            <div style="padding:8px 16px; color:rgba(255,255,255,0.4);">
                <MudText Typo="Typo.body2">No menu items available.</MudText>
            </div>
        }

        @* Data views, listed from the DataView table rather than from Navigation, so one added
           today is reachable today. *@
        <MudDivider Style="margin:8px 0; border-color:rgba(255,255,255,0.1);" />

        <MudText Typo="Typo.caption" Style="padding:8px 16px; color:rgba(255,255,255,0.5); text-transform:uppercase; font-weight:700; letter-spacing:0.05em;">
            Data Views
        </MudText>

        @if (_dataViews.Count == 0)
        {
            <div style="padding:8px 16px; color:rgba(255,255,255,0.4);">
                <MudText Typo="Typo.body2">No published data views.</MudText>
            </div>
        }
        else
        {
            @foreach (var view in _dataViews)
            {
                var captured = view;
                <div class="nav-side-item"
                     style="padding:6px 16px; display:flex; align-items:center; gap:8px; cursor:pointer; color:rgba(255,255,255,0.8);"
                     @onclick="@(() => NavigationManager.NavigateTo($"/aspclassic-vbscript/dataview?ViewID={captured.ViewID}"))"
                     title="@captured.Title">
                    <MudIcon Icon="@Icons.Material.Filled.TableChart"
                             Size="Size.Small"
                             Style="color:rgba(255,255,255,0.6);" />
                    <MudText Typo="Typo.body2" Style="color:inherit;">@captured.Title</MudText>
                </div>
            }
        }
    </div>
</div>

@* Recursive menu item renderer *@
@{
    RenderFragment RenderNavNode(NavigationNodeDto node, int depth)
    {
        return __builder =>
        {
            var paddingLeft = 16 + (depth * 16);
            var hasChildren = node.Children is not null && node.Children.Count > 0;
            var isExpanded = _expandedNodes.Contains(node.NavId);

            if (hasChildren)
            {
                @* Parent node with children — expandable *@
                <div>
                    <div class="nav-side-item"
                         style="padding:6px 16px 6px @(paddingLeft)px; display:flex; align-items:center; gap:8px; cursor:pointer; color:rgba(255,255,255,0.8); transition:background 0.15s;"
                         @onclick="() => ToggleNode(node.NavId)"
                         @onclick:stopPropagation="true">
                        @if (!string.IsNullOrWhiteSpace(node.NavGlyph))
                        {
                            <MudIcon Icon="@MapGlyphToIcon(node.NavGlyph)" Size="Size.Small" Style="color:rgba(255,255,255,0.6);" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Style="color:rgba(255,255,255,0.6);" />
                        }
                        <MudText Typo="Typo.body2" Style="flex:1; color:inherit;">@node.NavLabel</MudText>
                        <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="Size.Small"
                                 Style="color:rgba(255,255,255,0.4);" />
                    </div>
                    @if (isExpanded)
                    {
                        @foreach (var child in node.Children!)
                        {
                            @RenderNavNode(child, depth + 1)
                        }
                    }
                </div>
            }
            else
            {
                @* Leaf node — navigable link *@
                var navHref = ResolveNavUri(node);
                <div class="nav-side-item"
                     style="padding:6px 16px 6px @(paddingLeft)px; display:flex; align-items:center; gap:8px; cursor:pointer; color:rgba(255,255,255,0.8); transition:background 0.15s;"
                     @onclick="() => NavigateToNode(node)"
                     @onclick:stopPropagation="true"
                     title="@(node.NavTooltip ?? node.NavLabel)">
                    @if (!string.IsNullOrWhiteSpace(node.NavGlyph))
                    {
                        <MudIcon Icon="@MapGlyphToIcon(node.NavGlyph)" Size="Size.Small" Style="color:rgba(255,255,255,0.6);" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Style="color:rgba(255,255,255,0.4); font-size:8px;" />
                    }
                    <MudText Typo="Typo.body2" Style="color:inherit;">@node.NavLabel</MudText>
                </div>
            }
        };
    }
}

<style>
    .nav-side-item:hover {
        background-color: rgba(255, 255, 255, 0.08);
    }
</style>

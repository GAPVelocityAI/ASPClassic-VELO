@page "/aspclassic-vbscript/page500"
@namespace ASPClassic.Pages.Page

@using MudBlazor

<!-- Port of 500.asp — 500 Server Error page -->

<PageTitle>@_pageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <!-- Content Header (Page header) -->
    <MudGrid>
        <MudItem xs="6">
            <MudText Typo="Typo.h4" Class="m-0">@_pageTitle</MudText>
        </MudItem>
        <MudItem xs="6" Class="d-flex justify-end">
            <MudBreadcrumbs Items="_breadcrumbs" />
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-4" />

    <!-- Main content — error page -->
    <MudPaper Elevation="0" Class="pa-8">
        <MudGrid Justify="Justify.Center" Spacing="4">
            <MudItem xs="12" sm="4" Class="d-flex justify-center align-center">
                <MudText Typo="Typo.h1" Color="Color.Error" Style="font-size:7rem; font-weight:700;">500</MudText>
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudText Typo="Typo.h5" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mr-2" />
                    Oops! Something went wrong.
                </MudText>
                <MudText Typo="Typo.body1" Class="mb-4">
                    We will work on fixing that right away.
                    Meanwhile, you may <MudLink Href="/aspclassic-vbscript/default" Underline="Underline.Always">return to dashboard</MudLink> or try using the search form.
                </MudText>

                <MudGrid>
                    <MudItem xs="9" sm="8">
                        <MudTextField @bind-Value="_searchTerm"
                                      Placeholder="Search"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      AdornmentColor="Color.Error"
                                      OnAdornmentClick="OnSearchClick"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="3" sm="4" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="OnSearchClick"
                                   Size="Size.Medium">
                            Search
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>
